<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Brigade declares NO permissions, deliberately.

        Storage Access Framework grants are not permissions, and the app never
        touches the network. Adding a <uses-permission> here should require a very
        good reason: the empty list is both a feature and a guard against scope creep.
    -->

    <application
        android:name=".BrigadeApp"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Brigade">

        <!--
            Samsung DeX hints: reduce process and Activity restarts across DeX
            transitions. Non-Samsung devices ignore unknown meta-data, so these are
            harmless elsewhere. They are an optimisation, not a correctness crutch —
            presentation state lives on the Application and survives restarts anyway.
        -->
        <meta-data
            android:name="com.samsung.android.keepalive.density"
            android:value="true" />
        <meta-data
            android:name="com.samsung.android.multidisplay.keep_process_alive"
            android:value="true" />

        <activity
            android:name=".ui.GmActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Lends the Séances image to whichever app the GM shares it with, one read grant at
            a time. Not a permission, and not exported: no other app can reach it unasked.
            The authority must match SHARE_AUTHORITY_SUFFIX in SeancesScreen.kt.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>

</manifest>
