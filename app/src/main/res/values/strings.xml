<?xml version="1.0" encoding="utf-8"?>
<!--
    This is the BASE resource set and it is French (DESIGN_REQUIREMENTS.md §21).

    French is deliberately not in values-fr/: as the base set it is also the fallback,
    so Brigade is French on a device set to any language. Adding another language
    later means adding res/values-xx/strings.xml and changing no code.

    No user-facing string literal may appear in Kotlin source.
-->
<resources>

    <string name="app_name" translatable="false">Brigade</string>

    <!-- Campaign folder -->
    <string name="browser_choose_folder">Choisir le dossier de campagne</string>
    <string name="browser_change_folder">Changer de dossier</string>
    <string name="browser_no_folder_title">Aucune campagne ouverte</string>
    <string name="browser_no_folder_body">Choisissez le dossier qui contient les images de votre campagne. Brigade lit vos fichiers sans les copier ni les modifier.</string>
    <string name="browser_root">Campagne</string>
    <string name="browser_empty">Ce dossier est vide</string>
    <!-- Marks a Markdown note, in the browser and on a slot holding one. -->
    <string name="browser_note_badge" translatable="false">MD</string>
    <string name="browser_folder_unavailable">Dossier indisponible. Choisissez-en un autre.</string>
    <string name="browser_refresh">Actualiser</string>

    <!-- Image menu -->
    <string name="action_show">Afficher</string>
    <string name="action_assign_slot">Emplacement %1$d</string>
    <string name="action_clear_slot">Vider l\'emplacement</string>
    <string name="action_close">Fermer</string>

    <!-- Player preview -->
    <string name="preview_no_display">Aucun écran joueur</string>
    <!-- Resolution first: it is the part the GM actually needs, and some display names
         are long enough to be truncated (a simulated display is named, in full,
         "Superposition n°1 : 1920 x 1080, 320 dpi"). -->
    <string name="preview_display">%1$d × %2$d · %3$s</string>
    <!-- Shown on the preview while the GM is zoomed in. Formatted in the resources' locale,
         so French gets a decimal comma: «× 1,6». -->
    <string name="preview_zoom">× %1$.1f</string>

    <!-- Control bar -->
    <string name="control_info">INFO</string>
    <string name="control_timer">SABLIER</string>

    <!-- Timer -->
    <string name="timer_title">Sablier</string>
    <string name="timer_minutes">%1$d min</string>
    <string name="timer_extend">Encore 1 minute</string>
    <string name="timer_stop">Arrêter</string>
    <string name="slot_empty">Emplacement %1$d, vide</string>
    <string name="slot_filled">Emplacement %1$d : %2$s</string>
    <string name="slot_missing">Fichier introuvable</string>

    <!-- Session recap: Brigade.md at the campaign root, read by the GM in Obsidian. -->
    <string name="recap_title">Séances</string>
    <string name="recap_notice">Tenu à jour par Brigade d\'après ce que les joueurs ont eu sous les yeux. Réécrit après chaque changement à l\'écran : ne le modifiez pas, vos modifications seraient perdues.</string>
    <string name="recap_column_start">Début</string>
    <string name="recap_column_panel">Panneau</string>
    <string name="recap_column_duration">Durée</string>
    <string name="recap_column_total">Total</string>
    <string name="recap_longest">Le plus longtemps à l\'écran</string>
    <string name="recap_black">Noir</string>
    <!-- %1$s the date, %2$s the start time, %3$s the end time (with its weekday past
         midnight), %4$s how long the session lasted. -->
    <string name="recap_session_heading">%1$s · %2$s → %3$s · %4$s</string>
    <string name="recap_duration_hours">%1$d h %2$02d</string>
    <string name="recap_duration_minutes">%1$d min</string>
    <string name="recap_duration_seconds">%1$d s</string>

    <!-- Errors -->
    <string name="error_slots_save">Impossible d\'enregistrer les emplacements</string>
    <string name="error_recap_save">Impossible d\'écrire Brigade.md</string>
    <string name="error_recap_not_ours">Un Brigade.md écrit par quelqu\'un d\'autre existe déjà : Brigade n\'y touche pas</string>

</resources>
